// front/app.at — Database Studio SQLite 只读浏览器（DATABASE-001）。
//
// T-04 去模拟化：对象树/数据表/Schema/SQL 控制台全部接真实 SQLite 文件
// （经 back/db.at 只读合同，见 docs/plans/evidence/001/capability-decision.md）。
// 移除：内置演示数据、模拟事务（Add Row/Commit/Rollback/Reset）、关键字切换
// RunSql、假排序。NULL 单元格显示为 "NULL"；写控件不存在（只读应用）。
// 视图层零算术零索引——展示行由 DbStore 预物化。

use db_store: DbStore
use components.tree_util: filter_tree, collect_ids, toggle_id

widget App {
    use { package: official from "./components" }
    msg {
        Init, WPathInput(str), WOpenDb, WCloseDb, WTreeFilterChanged(str),
        WDbToggle(str), WDbSelect(str), WSelectTab(str),
        WFirstPage, WPrevPage, WNextPage, WLastPage,
        WPageSize10, WPageSize25, WPageSize50,
        WSortCol(str), WSearchChanged(str), WSetSql(str), WRunSql, WClearSql,
        WPresetSelect, WPresetAgg, WPresetCte, WPresetReject
    }

    model {
    }

    on {
        .Init -> { store.Init() }
        .WPathInput(v) -> { store.PathInput(v) }
        .WOpenDb -> { store.OpenDb() }
        .WCloseDb -> { store.CloseDb() }
        .WTreeFilterChanged(kw) -> { store.TreeFilterChanged(kw) }
        .WDbToggle(id) -> { store.DbToggle(id) }
        .WDbSelect(id) -> { store.DbSelect(id) }
        .WSelectTab(tab) -> { store.SelectTab(tab) }
        .WFirstPage -> { store.FirstPage() }
        .WPrevPage -> { store.PrevPage() }
        .WNextPage -> { store.NextPage() }
        .WLastPage -> { store.LastPage() }
        .WPageSize10 -> { store.SetPageSize10() }
        .WPageSize25 -> { store.SetPageSize25() }
        .WPageSize50 -> { store.SetPageSize50() }
        .WSortCol(c) -> { store.SortCol(c) }
        .WSearchChanged(kw) -> { store.SearchChanged(kw) }
        .WSetSql(q) -> { store.SetSql(q) }
        .WRunSql -> { store.RunSql() }
        .WClearSql -> { store.ClearSql() }
        .WPresetSelect -> { store.PresetSelect() }
        .WPresetAgg -> { store.PresetAgg() }
        .WPresetCte -> { store.PresetCte() }
        .WPresetReject -> { store.PresetReject() }
    }

    view {
        col (style: "w-full h-full min-h-screen bg-background text-foreground flex flex-col overflow-hidden") {
            // ---- 顶栏 Header ----
            row (style: "items-center justify-between px-3 py-1.5 border-b bg-card shrink-0 gap-2") {
                row (style: "items-center gap-2 min-w-0") {
                    span (style: "w-6 h-6 rounded bg-primary/20 text-primary flex items-center justify-center text-sm shrink-0") {
                        text "🗄" {}
                    }
                    h1 "Database Studio" { style: "text-sm font-bold tracking-tight shrink-0 leading-none m-0 py-1" }
                    if .store.connected {
                        badge (text: "READ-ONLY", variant: "secondary") {}
                        text .store.file_name { style: "text-xs text-muted-foreground truncate" }
                    } else {
                        badge (text: "未打开", variant: "outline") {}
                    }
                }
                row (style: "items-center gap-3") {
                    if .store.connected {
                        row (style: "items-center gap-2 text-xs text-muted-foreground") {
                            span (style: "w-2 h-2 rounded-full bg-green-500") {}
                            text f"${.store.table_count} Tables · ${.store.view_count} Views · ${.store.index_count} Indexes" {}
                        }
                    }
                }
            }

            // ---- 打开/关闭栏 ----
            col (style: "px-3 py-2 border-b bg-card/50 shrink-0 gap-1") {
                row (style: "items-center gap-2") {
                    input {
                        placeholder: "SQLite 文件路径（例如 D:\\data\\app.db）",
                        value: .store.path_input,
                        oninput: .WPathInput,
                        style: "flex-1 px-3 py-1.5 text-xs rounded-md border bg-background focus:ring-1 focus:ring-primary outline-none font-mono"
                    }
                    button "打开" {
                        onclick: .WOpenDb,
                        style: "px-4 py-1.5 text-xs rounded-md bg-primary text-primary-foreground font-semibold hover:bg-primary/90"
                    }
                    if .store.connected {
                        button "关闭" {
                            onclick: .WCloseDb,
                            style: "px-3 py-1.5 text-xs rounded-md border border-border bg-background hover:bg-accent text-muted-foreground"
                        }
                    }
                }
                if .store.open_err != "" {
                    row (style: "items-center gap-2 px-3 py-1.5 rounded bg-destructive/10 border border-destructive/30 text-xs text-destructive") {
                        text f"打开失败（${.store.open_err}）${.store.open_detail}" { style: "font-mono" }
                    }
                }
            }

            // ---- 主工作区 ----
            if .store.connected {
                row (style: "flex-1 min-h-0") {
                    // ---- 左侧对象树 ----
                    col (style: "w-52 border-r bg-card/50 flex flex-col shrink-0") {
                        col (style: "p-3 border-b") {
                            input {
                                placeholder: "Filter database objects...",
                                value: .store.treeFilter,
                                oninput: .WTreeFilterChanged,
                                style: "w-full px-2.5 py-1.5 text-xs rounded-md border bg-background focus:ring-1 focus:ring-primary outline-none"
                            }
                        }
                        col (style: "flex-1 overflow-y-auto p-2 min-h-0") {
                            TreeView (nodes: .store.dbNodesFull, expanded: .store.dbExpanded, selected: .store.dbSelId, on_toggle: .WDbToggle, on_select: .WDbSelect, directory: true) {}
                        }
                    }

                    // ---- 右侧主内容区 ----
                    col (style: "flex-1 flex flex-col min-w-0 bg-background") {
                        // Tab 切换条
                        row (style: "items-center justify-between px-3 border-b bg-card/30 shrink-0 gap-2") {
                            row (style: "gap-1") {
                                button "Data" {
                                    onclick: () => { .WSelectTab("data") },
                                    style: if .store.activeTab == "data" { "px-2.5 py-1.5 text-xs font-semibold border-b-2 border-primary text-primary bg-transparent" } else { "px-2.5 py-1.5 text-xs text-muted-foreground hover:text-foreground bg-transparent" }
                                }
                                button "Schema" {
                                    onclick: () => { .WSelectTab("schema") },
                                    style: if .store.activeTab == "schema" { "px-2.5 py-1.5 text-xs font-semibold border-b-2 border-primary text-primary bg-transparent" } else { "px-2.5 py-1.5 text-xs text-muted-foreground hover:text-foreground bg-transparent" }
                                }
                                button "SQL" {
                                    onclick: () => { .WSelectTab("console") },
                                    style: if .store.activeTab == "console" { "px-2.5 py-1.5 text-xs font-semibold border-b-2 border-primary text-primary bg-transparent" } else { "px-2.5 py-1.5 text-xs text-muted-foreground hover:text-foreground bg-transparent" }
                                }
                            }
                            if .store.activeTable != "" {
                                text f"${.store.activeTable} · ${.store.activeType}" { style: "text-[11px] text-muted-foreground truncate max-w-[45%] text-right" }
                            }
                        }

                        // 数据错误横幅
                        if .store.data_err != "" {
                            row (style: "items-center px-6 py-2 bg-destructive/10 text-xs border-b") {
                                text f"读取失败：${.store.data_err}" { style: "font-mono text-destructive" }
                            }
                        }

                        // === Tab 1: Data Browse ===
                        if .store.activeTab == "data" {
                            col (style: "flex-1 p-2 gap-2 flex flex-col min-h-0") {
                                row (style: "items-center justify-between gap-4") {
                                    row (style: "items-center gap-2 flex-1") {
                                        input {
                                            placeholder: f"Filter records in ${.store.activeTable}...",
                                            value: .store.searchKw,
                                            oninput: .WSearchChanged,
                                            style: "w-64 px-3 py-1.5 text-xs rounded-md border bg-background focus:ring-1 focus:ring-primary outline-none"
                                        }
                                    }
                                    row (style: "items-center gap-1.5 shrink-0 text-xs") {
                                        text .store.showingText { style: "text-[11px] text-muted-foreground whitespace-nowrap" }
                                        button "‹‹" { onclick: .WFirstPage, style: "h-7 w-7 p-0 rounded border bg-card hover:bg-accent text-foreground" }
                                        button "‹" { onclick: .WPrevPage, style: "h-7 w-7 p-0 rounded border bg-card hover:bg-accent text-foreground" }
                                        text f"${.store.page} / ${.store.totalPages}" { style: "px-1 font-medium tabular-nums" }
                                        button "›" { onclick: .WNextPage, style: "h-7 w-7 p-0 rounded border bg-card hover:bg-accent text-foreground" }
                                        button "››" { onclick: .WLastPage, style: "h-7 w-7 p-0 rounded border bg-card hover:bg-accent text-foreground" }
                                        row (style: "items-center gap-0.5 ml-1 text-[11px] text-muted-foreground") {
                                            button "10" { onclick: .WPageSize10, style: if .store.pageSize == 10 { "h-6 px-1.5 rounded bg-primary text-primary-foreground" } else { "h-6 px-1.5 rounded border" } }
                                            button "25" { onclick: .WPageSize25, style: if .store.pageSize == 25 { "h-6 px-1.5 rounded bg-primary text-primary-foreground" } else { "h-6 px-1.5 rounded border" } }
                                            button "50" { onclick: .WPageSize50, style: if .store.pageSize == 50 { "h-6 px-1.5 rounded bg-primary text-primary-foreground" } else { "h-6 px-1.5 rounded border" } }
                                        }
                                    }
                                }

                                // 动态列表格（真实 schema 列名；NULL 显示为 NULL）
                                if .store.colNames.len() > 0 {
                                    col (style: "flex-1 border rounded-lg overflow-auto bg-card min-h-0 min-w-0") {
                                        table {
                                            table-header {
                                                table-row {
                                                    for h in .store.colNames {
                                                        table-head (text: h, onclick: .WSortCol(h), style: "font-semibold px-2 py-1 text-xs whitespace-nowrap cursor-pointer select-none") {}
                                                    }
                                                }
                                            }
                                            table-body {
                                                for ri, row in .store.vVals {
                                                    table-row (key: ri) {
                                                        for cell in row.vals {
                                                            table-cell (text: cell, style: "text-xs px-2 py-1 font-mono whitespace-nowrap") {}
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                } else {
                                    col (style: "flex-1 items-center justify-center text-muted-foreground text-sm gap-2") {
                                        text "从左侧选择表或视图" {}
                                    }
                                }
                            }
                        }

                        // === Tab 2: Schema / DDL ===
                        if .store.activeTab == "schema" {
                            col (style: "flex-1 p-6 gap-6 overflow-y-auto") {
                                if .store.schema_err != "" {
                                    row (style: "px-3 py-2 rounded bg-destructive/10 border border-destructive/30 text-xs") {
                                        text f"读取结构失败：${.store.schema_err}" { style: "font-mono text-destructive" }
                                    }
                                }
                                col (style: "gap-2") {
                                    row (style: "items-center justify-between") {
                                        text "Column Definitions" { style: "text-sm font-semibold" }
                                        badge (text: f"${.store.schemaCols.len()} Columns", variant: "secondary") {}
                                    }
                                    table {
                                        table-header {
                                            table-row {
                                                table-head (text: "Column Name", style: "font-semibold") {}
                                                table-head (text: "Data Type") {}
                                                table-head (text: "Not Null") {}
                                                table-head (text: "Default") {}
                                                table-head (text: "Key") {}
                                            }
                                        }
                                        table-body {
                                            for i, c in .store.schemaCols {
                                                table-row (key: i) {
                                                    table-cell (text: c.name, style: "font-mono font-medium text-xs") {}
                                                    table-cell {
                                                        badge (text: c.ctype, variant: "outline") {}
                                                    }
                                                    table-cell (text: c.notnull, style: "text-xs text-muted-foreground") {}
                                                    table-cell (text: c.dflt, style: "font-mono text-xs text-muted-foreground") {}
                                                    table-cell {
                                                        if c.pk {
                                                            badge (text: "PRIMARY KEY", variant: "default") {}
                                                        } else {
                                                            text "-" { style: "text-xs text-muted-foreground" }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                                if .store.schemaIdx.len() > 0 {
                                    col (style: "gap-2") {
                                        text "Indexes" { style: "text-sm font-semibold" }
                                        for i, line in .store.schemaIdx {
                                            text line { style: "font-mono text-xs" }
                                        }
                                    }
                                }
                                col (style: "gap-2") {
                                    text "DDL SQL Definition" { style: "text-sm font-semibold" }
                                    col (style: "p-4 rounded-lg bg-card border font-mono text-xs text-foreground whitespace-pre overflow-x-auto") {
                                        text .store.schemaDdl {}
                                    }
                                }
                            }
                        }

                        // === Tab 3: SQL Console ===
                        if .store.activeTab == "console" {
                            col (style: "flex-1 p-6 gap-4 flex flex-col min-h-0") {
                                row (style: "items-center gap-2 flex-wrap text-xs") {
                                    text "Presets:" { style: "text-muted-foreground font-semibold" }
                                    button "SELECT LIMIT" { onclick: .WPresetSelect, style: "px-2.5 py-1 rounded border bg-card hover:bg-accent" }
                                    button "GROUP BY" { onclick: .WPresetAgg, style: "px-2.5 py-1 rounded border bg-card hover:bg-accent" }
                                    button "CTE" { onclick: .WPresetCte, style: "px-2.5 py-1 rounded border bg-card hover:bg-accent" }
                                    button "写语句(应拒绝)" { onclick: .WPresetReject, style: "px-2.5 py-1 rounded border border-destructive/40 text-destructive hover:bg-destructive/10" }
                                }
                                col (style: "gap-2") {
                                    input {
                                        placeholder: "单条只读 SQL（SELECT / 只读 CTE）…",
                                        value: .store.sqlInput,
                                        oninput: .WSetSql,
                                        style: "w-full px-4 py-3 font-mono text-sm rounded-lg border bg-card focus:ring-2 focus:ring-primary outline-none"
                                    }
                                    row (style: "items-center justify-between") {
                                        row (style: "items-center gap-2") {
                                            button "▶ Run SQL" {
                                                onclick: .WRunSql,
                                                style: "px-4 py-1.5 text-xs rounded-md bg-primary text-primary-foreground font-semibold hover:bg-primary/90"
                                            }
                                            button "Clear" {
                                                onclick: .WClearSql,
                                                style: "px-3 py-1.5 text-xs rounded-md border bg-card hover:bg-accent text-muted-foreground"
                                            }
                                        }
                                        if .store.sqlStatus == "success" {
                                            row (style: "items-center gap-2 text-xs text-green-600 font-medium") {
                                                span (style: "w-2 h-2 rounded-full bg-green-500") {}
                                                text .store.sqlMeta {}
                                            }
                                        }
                                    }
                                }
                                if .store.sqlStatus == "error" {
                                    col (style: "p-4 rounded-lg bg-destructive/10 border border-destructive/30 gap-1") {
                                        row (style: "items-center gap-2 text-destructive font-semibold text-xs") {
                                            text "✕ SQL 错误" {}
                                        }
                                        text .store.sqlErr { style: "font-mono text-xs text-destructive" }
                                    }
                                }
                                if .store.sqlStatus == "success" {
                                    if .store.qColNames.len() > 0 {
                                        col (style: "flex-1 border rounded-lg overflow-auto bg-card min-h-0") {
                                            table {
                                                table-header {
                                                    table-row {
                                                        for h in .store.qColNames {
                                                            table-head (text: h, style: "font-semibold px-2 py-1 text-xs whitespace-nowrap") {}
                                                        }
                                                    }
                                                }
                                                table-body {
                                                    for ri, row in .store.qVals {
                                                        table-row (key: ri) {
                                                            for cell in row.vals {
                                                                table-cell (text: cell, style: "text-xs px-2 py-1 font-mono whitespace-nowrap") {}
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                                text "只读连接：写语句/PRAGMA/ATTACH/多语句会被拒绝（引擎级 query_only + 语句守卫）" { style: "text-[11px] text-muted-foreground" }
                            }
                        }
                    }
                }
            } else {
                col (style: "flex-1 items-center justify-center gap-3 text-muted-foreground") {
                    text "输入 SQLite 文件路径并点击「打开」" { style: "text-sm" }
                    text "本应用为只读浏览器：不会创建、修改或写入任何数据库文件" { style: "text-xs" }
                }
            }
        }
    }
}
