// back/db.at — DATABASE-001 只读 SQLite 数据层（T-02/T-03）。
// 生成器约定：所有 #[api] 端点经 db 层薄委托（probe 端点同样经此转发）。
//
// 能力合同：docs/plans/evidence/001/capability-decision.md（T-01 冻结协议 v1）。
// 无跨请求连接状态：每个请求 open→用→RAII 关闭（句柄生命周期可观测，AC-04）。
// 只读三层：①guard_sql 单语句+首token+旁路关键字守卫 ②PRAGMA query_only=ON
// 引擎强制 ③验收哈希 oracle（V-03）。任意 SELECT 的真实列名与 NULL 标志经
// describe-view + 派生表包装协议取得（P7 实证）。
// 错误隔离：a2r last_error 为进程级全局且成功不清空（G-1）——金丝雀对比判定。
//
// 发射器边界（已实测登记，capability-decision §3）：SqliteDb 不得进入用户
// struct（E0405）；fs.size/fs.filename 无发射映射（E0423）——文件名由
// base_name 自算，字节数不上报（宁缺勿假）。

use auto.json
use auto.sqlite
use api: FileMeta, ObjInfo, ObjectList, ColumnInfo, IndexInfo, ColumnList, TableData, IndexList, SchemaInfo, QueryResult
use probe

// ═══════════════════════════════════════════════════════════
// 基础助手
// ═══════════════════════════════════════════════════════════

/// SQL 字符串字面量：单引号包裹 + 内部 ' 翻倍。
fn sq(s str) str {
    return "'" + s.replace("'", "''") + "'"
}

/// SQL 标识符：[方括号] 引用 + 内部 ] 翻倍（bundled SQLite 方括号方言）。
fn ident(s str) str {
    return "[" + s.replace("]", "]]") + "]"
}

/// LIKE 模式转义：\ % _ 前置反斜杠（配 ESCAPE '\' 使用）。
fn like_pattern(kw str) str {
    var t str = kw.replace("\\", "\\\\")
    t = t.replace("%", "\\%")
    t = t.replace("_", "\\_")
    return "%" + t + "%"
}

/// 路径末段文件名（发射器无 fs.filename 映射；char_at 字符序自末向前扫）。
/// 含非 ASCII 字符的路径返回全路径（sub 为字节切片不可安全截取，宁繁勿错）。
fn base_name(p str) str {
    var n int = p.len()
    var i int = n - 1
    var k int = -1
    var ascii bool = true
    while i >= 0 {
        var cp int = p.char_at(i)
        if cp >= 128 {
            ascii = false
            i = -1
        } else {
            if cp == 47 {
                k = i
                i = -1
            } else {
                if cp == 92 {
                    k = i
                    i = -1
                } else {
                    i = i - 1
                }
            }
        }
    }
    if !ascii {
        return p
    }
    if k < 0 {
        return p
    }
    var segs = p.split("/")
    var segs2 = p.split("\\")
    if segs2.len() > segs.len() {
        segs = segs2
    }
    return segs[segs.len() - 1]
}

/// 金丝雀：跑一个必然语法失败的查询，把全局 last_error 置为已知文本并返回，
/// 作为操作前基线（操作后再取：文本变化 ⇔ 本次操作失败，且新文本即错误详情）。
fn canary(db SqliteDb) str {
    var _r List<List<str>> = db.query("SELECT 'canary-no-such-syntax-42")
    return sqlite.last_error()
}

/// 打开后验证（读路径共用）：sqlite_master 试读 + query_only=ON。
/// 返回 ""=通过；否则为错误码；详情由调用方直读 sqlite.last_error()。
fn open_verify(db SqliteDb) str {
    var base str = canary(db)
    var probe List<List<str>> = db.query("SELECT COUNT(*) FROM sqlite_master")
    if probe.len() != 1 {
        return "not_a_database"
    }
    var qo int = db.exec("PRAGMA query_only=ON")
    if qo < 0 {
        return "readonly_setup_failed"
    }
    return ""
}

/// 打开前的路径判定（各 pub fn 共用）：空→"empty_path"；不存在→
/// "file_not_found"（绝不 open——open 会静默建文件，P1）；否则 ""。
fn precheck(path str) str {
    var clean str = path.trim()
    if clean == "" {
        return "empty_path"
    }
    if !fs.exists(clean) {
        return "file_not_found"
    }
    return ""
}

// ═══════════════════════════════════════════════════════════
// 守卫（只读层①）：单条语句 + 首 token ∈ {select, with} +
// 普通上下文无 pragma/attach/detach/load_extension。
// 引号/注释感知：'str'（'' 转义）、"ident"、[ident]（]] 转义）、`ident`、
// -- 行注释、/* 块注释。发射器 sub/len 为字节语义且越界即 panic（与 stdlib
// 边界，G-4）：前瞻统一用 char_at(i+1)（越界安全返回 0，不 panic）；非 ASCII 按单字节
// 分隔符处理（永不构成 ASCII 关键字，无害）。
// ═══════════════════════════════════════════════════════════

/// ASCII 码点是否为 token 字符（字母/数字/_/$）。多字节码点（≥128）按分隔符
/// 处理——它们永不构成 ASCII 关键字，只影响 token 边界，无害。
fn is_ident_cp(cp int) bool {
    if cp >= 97 {
        if cp <= 122 {
            return true
        }
    }
    if cp >= 65 {
        if cp <= 90 {
            return true
        }
    }
    if cp >= 48 {
        if cp <= 57 {
            return true
        }
    }
    if cp == 95 {
        return true
    }
    if cp == 36 {
        return true
    }
    return false
}

/// ASCII 关键字的确定性哈希（31 多项式，模 1e9+7 防溢出；ASCII 下 char_at
/// 即码点）。token 用同一算法累计后与关键字哈希直接比对。
fn kw_hash(s str) int {
    var h int = 0
    var i int = 0
    while i < s.len() {
        h = (h * 31 + s.char_at(i)) % 1000000007
        i = i + 1
    }
    return h
}

/// 守卫（只读层①）：单条语句 + 首 token ∈ {select, with} +
/// 普通上下文无 pragma/attach/detach/load_extension。
/// 引号/注释感知：'str'（'' 转义）、"ident"、[ident]（]] 转义）、`ident`、
/// -- 行注释、/* 块注释。全程 char_at 码点整型遍历（sub 为字节切片且炸非
/// 边界，G-4）；token 以哈希累计比对（发射器不借用 Vec 实参，不能用数组
/// 参数；哈希碰撞最坏导致误拒，绝不误放行）。
/// 返回 ""=通过；否则 empty_statement | multi_statement | not_readonly
/// | forbidden_keyword:<tok>。
fn guard_sql(sql str) str {
    var t str = sql.trim().lower()
    if t == "" {
        return "empty_statement"
    }
    var h_sel int = kw_hash("select")
    var h_with int = kw_hash("with")
    var h_pragma int = kw_hash("pragma")
    var h_attach int = kw_hash("attach")
    var h_detach int = kw_hash("detach")
    var h_loadext int = kw_hash("load_extension")
    var n int = t.len()
    var i int = 0
    var stmts int = 1
    var ctx int = 0 // 0=normal 1=str 2=ident 3=bracket 4=backtick 5=line-cmt 6=block-cmt
    var h int = 0
    var toklen int = 0
    var first_h int = 0
    var first_len int = 0
    var forbidden str = ""
    var prev int = 0
    while i < n {
        var cp int = t.char_at(i)
        if ctx == 1 {
            if cp == 39 {
                if t.char_at(i + 1) == 39 {
                    i = i + 2
                } else {
                    ctx = 0
                    i = i + 1
                }
            } else {
                i = i + 1
            }
        } else {
            if ctx == 2 {
                if cp == 34 {
                    ctx = 0
                }
                i = i + 1
            } else {
                if ctx == 3 {
                    if cp == 93 {
                        if t.char_at(i + 1) == 93 {
                            i = i + 2
                        } else {
                            ctx = 0
                            i = i + 1
                        }
                    } else {
                        i = i + 1
                    }
                } else {
                    if ctx == 4 {
                        if cp == 96 {
                            ctx = 0
                        }
                        i = i + 1
                    } else {
                        if ctx == 5 {
                            if cp == 10 {
                                ctx = 0
                            }
                            i = i + 1
                        } else {
                            if ctx == 6 {
                                if cp == 47 {
                                    if prev == 42 {
                                        ctx = 0
                                    }
                                }
                                i = i + 1
                            } else {
                                // ── 普通上下文 ──
                                if is_ident_cp(cp) {
                                    h = (h * 31 + cp) % 1000000007
                                    toklen = toklen + 1
                                    i = i + 1
                                } else {
                                    if toklen > 0 {
                                        if first_len == 0 {
                                            first_h = h
                                            first_len = toklen
                                        }
                                        if h == h_pragma {
                                            forbidden = "pragma"
                                        }
                                        if h == h_attach {
                                            forbidden = "attach"
                                        }
                                        if h == h_detach {
                                            forbidden = "detach"
                                        }
                                        if h == h_loadext {
                                            forbidden = "load_extension"
                                        }
                                        h = 0
                                        toklen = 0
                                    }
                                    if cp == 39 {
                                        ctx = 1
                                        i = i + 1
                                    } else {
                                        if cp == 34 {
                                            ctx = 2
                                            i = i + 1
                                        } else {
                                            if cp == 91 {
                                                ctx = 3
                                                i = i + 1
                                            } else {
                                                if cp == 96 {
                                                    ctx = 4
                                                    i = i + 1
                                                } else {
                                                    if cp == 45 {
                                                        if t.char_at(i + 1) == 45 {
                                                            ctx = 5
                                                            i = i + 2
                                                        } else {
                                                            i = i + 1
                                                        }
                                                    } else {
                                                        if cp == 47 {
                                                            if t.char_at(i + 1) == 42 {
                                                                ctx = 6
                                                                i = i + 2
                                                            } else {
                                                                i = i + 1
                                                            }
                                                        } else {
                                                            if cp == 59 {
                                                                stmts = stmts + 1
                                                                i = i + 1
                                                            } else {
                                                                i = i + 1
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        prev = cp
    }
    if toklen > 0 {
        if first_len == 0 {
            first_h = h
            first_len = toklen
        }
        if h == h_pragma {
            forbidden = "pragma"
        }
        if h == h_attach {
            forbidden = "attach"
        }
        if h == h_detach {
            forbidden = "detach"
        }
        if h == h_loadext {
            forbidden = "load_extension"
        }
    }
    if forbidden != "" {
        return "forbidden_keyword:" + forbidden
    }
    if stmts > 1 {
        return "multi_statement"
    }
    if first_len == 0 {
        return "empty_statement"
    }
    if first_h != h_sel {
        if first_h != h_with {
            return "not_readonly"
        }
    }
    return ""
}

// ═══════════════════════════════════════════════════════════
// API 主体：open / objects / table_data / schema / query
// ═══════════════════════════════════════════════════════════

/// 打开文件：返回身份与对象计数；绝不成功于不存在/损坏文件。
pub fn open_db(path str) FileMeta {
    var m FileMeta = FileMeta { ok: false, err_code: "", err_detail: "", path: "", name: "",
        tables: 0, views: 0, indexes: 0 }
    m.path = path + ""
    var pre str = precheck(path)
    if pre != "" {
        m.err_code = pre
        return m
    }
    var clean str = path.trim()
    var db SqliteDb = sqlite.open(clean)
    var v str = open_verify(db)
    if v != "" {
        m.err_code = v
        m.err_detail = sqlite.last_error()
        return m
    }
    var cnt List<List<str>> = db.query("SELECT type, COUNT(*) FROM sqlite_master WHERE name NOT LIKE 'sqlite\\_%' ESCAPE '\\' GROUP BY type")
    var i int = 0
    while i < cnt.len() {
        var row0 = cnt[i]
        var k str = row0[0]
        var v2 int = str_to_int(row0[1])
        if k == "table" {
            m.tables = v2
        }
        if k == "view" {
            m.views = v2
        }
        if k == "index" {
            m.indexes = v2
        }
        i = i + 1
    }
    m.ok = true
    m.name = base_name(clean)
    return m
}

/// 对象树：sqlite_master 全部用户对象（表/视图/索引）。
pub fn list_objects(path str) ObjectList {
    var r ObjectList = ObjectList { ok: false, err_code: "", err_detail: "", objects: [] }
    var pre str = precheck(path)
    if pre != "" {
        r.err_code = pre
        return r
    }
    var db SqliteDb = sqlite.open(path.trim())
    var v str = open_verify(db)
    if v != "" {
        r.err_code = v
        r.err_detail = sqlite.last_error()
        return r
    }
    var rows List<List<str>> = db.query("SELECT type, name FROM sqlite_master WHERE name NOT LIKE 'sqlite\\_%' ESCAPE '\\' ORDER BY CASE type WHEN 'table' THEN 0 WHEN 'view' THEN 1 ELSE 2 END, name")
    var base str = canary(db)
    if rows.len() == 0 {
        var lerr str = sqlite.last_error()
        if lerr != base {
            r.err_code = "introspect_failed"
            r.err_detail = lerr
            return r
        }
    }
    r.ok = true
    var i int = 0
    while i < rows.len() {
        var row0 = rows[i]
        var oi ObjInfo = ObjInfo { otype: row0[0], name: row0[1] }
        r.objects.push(oi)
        i = i + 1
    }
    return r
}

/// PRAGMA table_info → 列模型（真实列名/类型/NOTNULL/默认值/PK）。
fn read_columns(db SqliteDb, tname str) []ColumnInfo {
    var cols []ColumnInfo = []
    var rows List<List<str>> = db.query("PRAGMA table_info(" + ident(tname) + ")")
    var i int = 0
    while i < rows.len() {
        var row0 = rows[i]
        var ci ColumnInfo = ColumnInfo { name: row0[1], ctype: row0[2],
            notnull: row0[3] == "1", dflt: row0[4], pk: row0[5] != "0" }
        cols.push(ci)
        i = i + 1
    }
    return cols
}

/// 列模型端点（真实 PRAGMA table_info）。
pub fn columns(path str, tname str) ColumnList {
    var r ColumnList = ColumnList { ok: false, err_code: "", err_detail: "", columns: [] }
    var pre str = precheck(path)
    if pre != "" {
        r.err_code = pre
        return r
    }
    var db SqliteDb = sqlite.open(path.trim())
    var v str = open_verify(db)
    if v != "" {
        r.err_code = v
        r.err_detail = sqlite.last_error()
        return r
    }
    r.columns = read_columns(db, tname)
    if r.columns.len() == 0 {
        r.err_code = "unknown_table"
        r.err_detail = "no such table or view: " + tname
        return r
    }
    r.ok = true
    return r
}

/// 表/视图数据页：值,标志交错扁平输出（列数由 /api/db/columns 提供）。
pub fn table_data(path str, tname str, page int, page_size int, sort_col str, sort_dir str, search str) TableData {
    var r TableData = TableData { ok: false, err_code: "", err_detail: "", cells: [],
        total: 0, page: page, page_size: page_size, showing: 0 }
    var pre str = precheck(path)
    if pre != "" {
        r.err_code = pre
        return r
    }
    var db SqliteDb = sqlite.open(path.trim())
    var v str = open_verify(db)
    if v != "" {
        r.err_code = v
        r.err_detail = sqlite.last_error()
        return r
    }
    var cols []ColumnInfo = read_columns(db, tname)
    if cols.len() == 0 {
        r.err_code = "unknown_table"
        r.err_detail = "no such table or view: " + tname
        return r
    }

    // WHERE（搜索：全文本列 LIKE ESCAPE）
    var where str = ""
    if search.trim() != "" {
        var pat str = sq(like_pattern(search.trim()))
        var parts str = ""
        var i int = 0
        while i < cols.len() {
            var cnw str = cols[i].name
            var one str = ident(cnw) + " LIKE " + pat + " ESCAPE '\\'"
            if parts == "" {
                parts = one
            } else {
                parts = parts + " OR " + one
            }
            i = i + 1
        }
        where = " WHERE " + parts
    }

    // ORDER BY（白名单校验）
    var order str = ""
    var sc str = sort_col.trim()
    if sc != "" {
        var found bool = false
        var wi int = 0
        while wi < cols.len() {
            if cols[wi].name == sc {
                found = true
                wi = cols.len()
            } else {
                wi = wi + 1
            }
        }
        if found {
            var dirn str = " ASC"
            if sort_dir.trim().lower() == "desc" {
                dirn = " DESC"
            }
            order = " ORDER BY " + ident(sc) + dirn
        }
    }

    // 总数
    var tot List<List<str>> = db.query("SELECT COUNT(*) FROM " + ident(tname) + where)
    var base str = canary(db)
    if tot.len() != 1 {
        var lerr str = sqlite.last_error()
        if lerr == base {
            lerr = "count query returned no row"
        }
        r.err_code = "query_failed"
        r.err_detail = lerr
        return r
    }
    var trow0 = tot[0]
    r.total = str_to_int(trow0[0])

    // 数据页（[c],[c] IS NULL 交错直接透传）
    var pairs str = ""
    var ci int = 0
    while ci < cols.len() {
        var cn str = cols[ci].name
        var pair str = ident(cn) + ", " + ident(cn) + " IS NULL"
        if pairs == "" {
            pairs = pair
        } else {
            pairs = pairs + ", " + pair
        }
        ci = ci + 1
    }
    var ps int = page_size
    if ps < 1 {
        ps = 10
    }
    if ps > 200 {
        ps = 200
    }
    var pg int = page
    if pg < 1 {
        pg = 1
    }
    var off int = (pg - 1) * ps
    var data List<List<str>> = db.query("SELECT " + pairs + " FROM " + ident(tname) + where + order + " LIMIT " + json.encode(ps) + " OFFSET " + json.encode(off))
    var derr str = sqlite.last_error()
    if derr != base {
        r.err_code = "query_failed"
        r.err_detail = derr
        return r
    }
    var ri int = 0
    while ri < data.len() {
        var src = data[ri]
        var k int = 0
        while k < src.len() {
            r.cells.push(src[k])
            k = k + 1
        }
        ri = ri + 1
    }
    r.showing = data.len()
    r.ok = true
    return r
}

/// 表/视图结构信息（DDL/ttype；无数组字段）。
pub fn schema_info(path str, tname str) SchemaInfo {
    var r SchemaInfo = SchemaInfo { ok: false, err_code: "", err_detail: "", tname: "",
        ttype: "", ddl: "" }
    r.tname = tname + ""
    var pre str = precheck(path)
    if pre != "" {
        r.err_code = pre
        return r
    }
    var db SqliteDb = sqlite.open(path.trim())
    var v str = open_verify(db)
    if v != "" {
        r.err_code = v
        r.err_detail = sqlite.last_error()
        return r
    }
    var master List<List<str>> = db.query("SELECT type, COALESCE(sql, '') FROM sqlite_master WHERE name = " + sq(tname))
    var base str = canary(db)
    if master.len() != 1 {
        var lerr str = sqlite.last_error()
        if lerr == base {
            lerr = "sqlite_master lookup failed"
        }
        r.err_code = "query_failed"
        r.err_detail = lerr
        return r
    }
    var mrow0 = master[0]
    r.ttype = mrow0[0]
    r.ddl = mrow0[1]
    r.ok = true
    return r
}

/// 索引清单（单数组）。
pub fn indexes(path str, tname str) IndexList {
    var r IndexList = IndexList { ok: false, err_code: "", err_detail: "", indexes: [] }
    var pre str = precheck(path)
    if pre != "" {
        r.err_code = pre
        return r
    }
    var db SqliteDb = sqlite.open(path.trim())
    var v str = open_verify(db)
    if v != "" {
        r.err_code = v
        r.err_detail = sqlite.last_error()
        return r
    }
    var cols []ColumnInfo = read_columns(db, tname)
    if cols.len() == 0 {
        r.err_code = "unknown_table"
        r.err_detail = "no such table or view: " + tname
        return r
    }
    var ilist List<List<str>> = db.query("PRAGMA index_list(" + ident(tname) + ")")
    var i int = 0
    while i < ilist.len() {
        var row0 = ilist[i]
        var iname str = row0[1]
        var iinfo List<List<str>> = db.query("PRAGMA index_info(" + ident(iname) + ")")
        var colsn str = ""
        var j int = 0
        while j < iinfo.len() {
            var irow0 = iinfo[j]
            if colsn == "" {
                colsn = irow0[2]
            } else {
                colsn = colsn + ", " + irow0[2]
            }
            j = j + 1
        }
        var uni bool = row0[2] == "1"
        var ii IndexInfo = IndexInfo { name: iname, cols: colsn, unique: uni, origin: row0[3] }
        r.indexes.push(ii)
        i = i + 1
    }
    r.ok = true
    return r
}

/// 控制台查询（单条只读 SELECT/CTE）：
/// 守卫 → describe-view 取真实列名 → query_only 连接跑派生表包装取值+NULL 标志。
/// cells 单数组：先列名×ncols，再每行【值,标志】交错；rowcount 不含表头。
/// 截断：LIMIT 1001，超出取前 1000 行并 truncated=true（显式截断，AC-04）。
pub fn run_query(path str, sql str) QueryResult {
    var r QueryResult = QueryResult { ok: false, err_code: "", err_detail: "", cells: [],
        ncols: 0, rowcount: 0, truncated: false }
    var body str = sql.trim()
    // 仅剥离尾随分号（其后全为空白）：分号后仍有内容则保留原文，由守卫按
    // 多语句拒绝（绝不静默截断用户语句）。
    var segs = body.split(";")
    if segs.len() > 1 {
        var extra bool = false
        var k0 int = 1
        while k0 < segs.len() {
            if segs[k0].trim() != "" {
                extra = true
                k0 = segs.len()
            } else {
                k0 = k0 + 1
            }
        }
        if !extra {
            body = segs[0].trim()
        }
    }
    var g str = guard_sql(body)
    if g != "" {
        r.err_code = "rejected"
        r.err_detail = g
        return r
    }
    var pre str = precheck(path)
    if pre != "" {
        r.err_code = pre
        return r
    }
    var db SqliteDb = sqlite.open(path.trim())
    var v str = open_verify(db)
    if v != "" {
        r.err_code = v
        r.err_detail = sqlite.last_error()
        return r
    }
    // describe 连接：仅 CREATE/DROP TEMP VIEW + table_info，绝不执行用户 SQL 主体。
    var desc SqliteDb = sqlite.open(path.trim())
    desc.exec("DROP VIEW IF EXISTS temp.__db1_desc")
    var cbase str = canary(desc)
    var cr int = desc.exec("CREATE TEMP VIEW __db1_desc AS " + body)
    var cerr str = sqlite.last_error()
    if cr < 0 {
        r.err_code = "query_failed"
        r.err_detail = cerr
        if cerr == cbase {
            r.err_detail = "statement is not a selectable query"
        }
        return r
    }
    // SQLite 视图为惰性解析：CREATE 可能成功而内层错误（如未知表）要到
    // table_info 才浮出——此处再取一次金丝雀基线，浮出的引擎原文优先呈现。
    var cbase2 str = canary(desc)
    var cinfo List<List<str>> = desc.query("PRAGMA table_info(__db1_desc)")
    if cinfo.len() == 0 {
        var lerr str = sqlite.last_error()
        r.err_code = "query_failed"
        r.err_detail = lerr
        if lerr == cbase2 {
            r.err_detail = "no result columns"
        }
        return r
    }
    // 列名 + 包装 SELECT（值,标志交错）
    var names []str = []
    var pairs str = ""
    var i int = 0
    while i < cinfo.len() {
        var row0 = cinfo[i]
        var cn str = row0[1]
        names.push(cn)
        var pair str = ident(cn) + ", " + ident(cn) + " IS NULL"
        if pairs == "" {
            pairs = pair
        } else {
            pairs = pairs + ", " + pair
        }
        i = i + 1
    }
    var nc int = names.len()
    var wrap str = "SELECT " + pairs + " FROM (" + body + "\n) LIMIT 1001"
    var dbase str = canary(db)
    var data List<List<str>> = db.query(wrap)
    var derr str = sqlite.last_error()
    if derr != dbase {
        r.err_code = "query_failed"
        r.err_detail = derr
        return r
    }
    if data.len() == 0 {
        // 合法空结果：仅列名头
        var hi int = 0
        while hi < nc {
            r.cells.push(names[hi])
            hi = hi + 1
        }
        r.ncols = nc
        r.rowcount = 0
        r.ok = true
        return r
    }
    // 列名头（cells = [列名×nc][值,标志 交错×rowcount×nc]）
    var hi int = 0
    while hi < nc {
        r.cells.push(names[hi])
        hi = hi + 1
    }
    var ri int = 0
    while ri < data.len() {
        var src = data[ri]
        var k int = 0
        while k < nc {
            r.cells.push(src[k * 2])
            r.cells.push(src[k * 2 + 1])
            k = k + 1
        }
        ri = ri + 1
    }
    // 截断按行：保留前 1000 行（每行 nc×2 格），超出行丢弃并标注 truncated
    var limit int = 1000 * nc * 2
    var totalCells int = r.cells.len() - nc
    if totalCells > limit {
        r.truncated = true
        var trimmed []str = []
        var ri2 int = 0
        var lim2 int = nc + limit
        while ri2 < lim2 {
            trimmed.push(r.cells[ri2])
            ri2 = ri2 + 1
        }
        r.cells = trimmed
    }
    r.ncols = nc
    r.rowcount = (r.cells.len() - nc) / (nc * 2)
    r.ok = true
    return r
}

/// str → int（引擎返回的数字单元格；负号与非数字安全为 0）。
fn str_to_int(s str) int {
    var v int = 0
    var neg bool = false
    var i int = 0
    var t str = s.trim()
    if t.starts_with("-") {
        neg = true
    }
    while i < t.len() {
        var cp int = t.char_at(i)
        if cp >= 48 {
            if cp <= 57 {
                v = v * 10 + cp - 48
            }
        }
        i = i + 1
    }
    if neg {
        v = 0 - v
    }
    return v
}


