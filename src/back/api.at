// back/api.at — DATABASE-001 后端 API。
//
// 真实只读浏览端点（/api/db/*）委托 sqlite_service（能力合同见
// docs/plans/evidence/001/capability-decision.md）。所有端点显式携带 path，
// 后端无跨请求连接状态（每请求 RAII 开关，AC-04）。失败一律 ok=false +
// err_code 可区分呈现（file_not_found | not_a_database | rejected |
// unknown_table | query_failed | …），绝不假成功。
// /api/probe/* 为 T-01 能力探针（AUTO_DB_PROBE=1 门禁），留作能力回归入口。

use db

// ═══════════════════════════════════════════════════════════
// Types (shared between frontend and backend)
// ═══════════════════════════════════════════════════════════

/// 打开文件结果：ok=false 时 err_code ∈ "" | empty_path | file_not_found |
/// not_a_database | readonly_setup_failed。
pub type FileMeta = {
    ok: bool
    err_code: str
    err_detail: str
    path: str
    name: str
    tables: int
    views: int
    indexes: int
}

pub type ObjInfo = {
    otype: str
    name: str
}

pub type ObjectList = {
    ok: bool
    err_code: str
    err_detail: str
    objects: []ObjInfo
}

pub type ColumnInfo = {
    name: str
    ctype: str
    notnull: bool
    dflt: str
    pk: bool
}

pub type IndexInfo = {
    name: str
    cols: str
    unique: bool
    origin: str
}

/// 表/视图结构结果。
pub type SchemaResult = {
    ok: bool
    err_code: str
    err_detail: str
    tname: str
    ttype: str
    columns: []ColumnInfo
    ddl: str
    indexes: []IndexInfo
}

/// 列模型清单（独立端点：VM 客户端解码边界 G-5——响应结构至多一个数组字段）。
pub type ColumnList = {
    ok: bool
    err_code: str
    err_detail: str
    columns: []ColumnInfo
}

/// 表/视图数据页：cells 为行优先扁平化的【值,标志交错】序列
/// （cells[r*nc*2+c*2]=值，cells[r*nc*2+c*2+1]="1"表示 NULL）；
/// 列数来自 /api/db/columns。total 为过滤后总数。
pub type TableData = {
    ok: bool
    err_code: str
    err_detail: str
    cells: []str
    total: int
    page: int
    page_size: int
    showing: int
}

/// 索引清单（独立端点，单数组）。
pub type IndexList = {
    ok: bool
    err_code: str
    err_detail: str
    indexes: []IndexInfo
}

/// 表/视图结构信息（无数组字段；列/索引走各自端点）。
pub type SchemaInfo = {
    ok: bool
    err_code: str
    err_detail: str
    tname: str
    ttype: str
    ddl: str
}

/// 控制台查询结果：单数组 cells =【列名×ncols】【值,标志 交错×rowcount×ncols】；
/// ncols 为列数；truncated=true 表示超过 1000 行被显式截断（非承诺上限）。
pub type QueryResult = {
    ok: bool
    err_code: str
    err_detail: str
    cells: []str
    ncols: int
    rowcount: int
    truncated: bool
}

// ═══════════════════════════════════════════════════════════
// API Endpoints
// ═══════════════════════════════════════════════════════════

/// 打开用户 SQLite 文件（只读会话语义；不存在/损坏明确失败）。
/// POST /api/db/open  body: {"path": "..."}
#[api(method = "POST", path = "/api/db/open")]
pub fn db_open(path str) FileMeta {
    return db.open_db(path)
}

/// 对象树（表/视图/索引）。
/// POST /api/db/objects  body: {"path": "..."}
#[api(method = "POST", path = "/api/db/objects")]
pub fn db_objects(path str) ObjectList {
    return db.list_objects(path)
}

/// 列模型（真实 PRAGMA table_info）。
/// POST /api/db/columns
#[api(method = "POST", path = "/api/db/columns")]
pub fn db_columns(path str, tname str) ColumnList {
    return db.columns(path, tname)
}

/// 表/视图数据页（值,标志交错；列模型走 /api/db/columns）。
/// POST /api/db/table_data
#[api(method = "POST", path = "/api/db/table_data")]
pub fn db_table_data(path str, tname str, page int, page_size int, sort_col str, sort_dir str, search str) TableData {
    return db.table_data(path, tname, page, page_size, sort_col, sort_dir, search)
}

/// 表/视图结构信息（DDL 等；无数组字段）。
/// POST /api/db/schema
#[api(method = "POST", path = "/api/db/schema")]
pub fn db_schema(path str, tname str) SchemaInfo {
    return db.schema_info(path, tname)
}

/// 索引清单。
/// POST /api/db/indexes
#[api(method = "POST", path = "/api/db/indexes")]
pub fn db_indexes(path str, tname str) IndexList {
    return db.indexes(path, tname)
}

/// 单条只读查询（cells 单数组：列名头 + 值,标志交错）。
/// POST /api/db/query
#[api(method = "POST", path = "/api/db/query")]
pub fn db_query(path str, sql str) QueryResult {
    return db.run_query(path, sql)
}

// ═══════════════════════════════════════════════════════════
// T-01 能力探针（AUTO_DB_PROBE=1 门禁在 probe 内部；其余返回 "disabled"）
// ═══════════════════════════════════════════════════════════

#[api(method = "GET", path = "/api/probe/open_missing")]
pub fn probe_open_missing() str {
    return db.probe_open_missing()
}

#[api(method = "GET", path = "/api/probe/open_garbage")]
pub fn probe_open_garbage() str {
    return db.probe_open_garbage()
}

#[api(method = "GET", path = "/api/probe/readonly_enforce")]
pub fn probe_readonly_enforce() str {
    return db.probe_readonly_enforce()
}

#[api(method = "GET", path = "/api/probe/readonly_flip")]
pub fn probe_readonly_flip() str {
    return db.probe_readonly_flip()
}

#[api(method = "GET", path = "/api/probe/attach_test")]
pub fn probe_attach_test() str {
    return db.probe_attach_test()
}

#[api(method = "GET", path = "/api/probe/schema_introspect")]
pub fn probe_schema_introspect() str {
    return db.probe_schema_introspect()
}

#[api(method = "GET", path = "/api/probe/describe_wrap")]
pub fn probe_describe_wrap() str {
    return db.probe_describe_wrap()
}

#[api(method = "GET", path = "/api/probe/multi_statement")]
pub fn probe_multi_statement() str {
    return db.probe_multi_statement()
}

#[api(method = "GET", path = "/api/probe/large_result")]
pub fn probe_large_result() str {
    return db.probe_large_result()
}
