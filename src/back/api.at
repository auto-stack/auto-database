// back/api.at — DATABASE-001 后端 API。
//
// T-01 阶段仅暴露环境门禁的能力探针端点（/api/probe/*，AUTO_DB_PROBE=1 才生效）；
// 真实只读浏览端点（open/schema/table_data/query/close）由 T-02/T-03 按同一
// 接缝补齐。生成器约定：所有 #[api] 端点经 db 层模块薄委托。

use probe

#[api(method = "GET", path = "/api/probe/open_missing")]
pub fn probe_open_missing() str {
    return probe.open_missing()
}

