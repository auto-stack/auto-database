#[api(method = "GET", path = "/api/probe/attach_test")]
pub fn probe_attach_test() str {
    return db.probe_attach_test()
}

#[api(method = "GET", path = "/api/probe/schema_introspect")]
pub fn probe_schema_introspect() str {
    return db.probe_schema_introspect()
}

#[api(method = "GET", path = "/api/probe/describe_wrap")]
pub fn probe_describe_wrap() str {
    return db.probe_describe_wrap()
}

#[api(method = "GET", path = "/api/probe/multi_statement")]
pub fn probe_multi_statement() str {
