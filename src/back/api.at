// back/api.at — DATABASE-001 后端 API。
//
// 真实只读浏览端点（/api/db/*）委托 sqlite_service（能力合同见
// docs/plans/evidence/001/capability-decision.md）。所有端点显式携带 path，
// 后端无跨请求连接状态（每请求 RAII 开关，AC-04）。失败一律 ok=false +
// err_code 可区分呈现（file_not_found | not_a_database | rejected |
// unknown_table | query_failed | …），绝不假成功。
// /api/probe/* 为 T-01 能力探针（AUTO_DB_PROBE=1 门禁），留作能力回归入口。

use db

// ═══════════════════════════════════════════════════════════
// Types (shared between frontend and backend)
// ═══════════════════════════════════════════════════════════

/// 打开文件结果：ok=false 时 err_code ∈ "" | empty_path | file_not_found |
/// not_a_database | readonly_setup_failed。
pub type FileMeta = {
    ok: bool
    err_code: str
    err_detail: str
    path: str
    name: str
    tables: int
    views: int
    indexes: int
}

pub type ObjInfo = {
    otype: str
    name: str
}

pub type ObjectList = {
    ok: bool
    err_code: str
    err_detail: str
    objects: []ObjInfo
}

pub type ColumnInfo = {
    name: str
    ctype: str
    notnull: bool
    dflt: str
    pk: bool
}

pub type IndexInfo = {
    name: str
    cols: str
    unique: bool
    origin: str
}

/// 表/视图结构结果。
pub type SchemaResult = {
    ok: bool
    err_code: str
    err_detail: str
    tname: str
    ttype: str
    columns: []ColumnInfo
    ddl: str
    indexes: []IndexInfo
}

/// 表/视图数据页：cells/nulls 为行优先扁平化（index = row*列数 + col，
/// 列数=columns.len()）；nulls 同型 0/1 标志。真实列名/类型来自
/// PRAGMA table_info；total 为过滤后总数。
pub type TableData = {
    ok: bool
    err_code: str
    err_detail: str
    columns: []ColumnInfo
    cells: []str
    nulls: []int
    total: int
    page: int
    page_size: int
    showing: int
}

/// 控制台查询结果：columns 为引擎真实列名；cells/nulls 同 TableData 扁平化；
/// truncated=true 表示超过 1000 行被显式截断（非承诺上限）。
pub type QueryResult = {
    ok: bool
    err_code: str
    err_detail: str
    columns: []str
    cells: []str
    nulls: []int
    rowcount: int
    truncated: bool
}

// ═══════════════════════════════════════════════════════════
// API Endpoints
// ═══════════════════════════════════════════════════════════

/// 打开用户 SQLite 文件（只读会话语义；不存在/损坏明确失败）。
/// POST /api/db/open  body: {"path": "..."}
#[api(method = "POST", path = "/api/db/open")]
pub fn db_open(path str) FileMeta {
    return db.open_db(path)
}

/// 对象树（表/视图/索引）。
/// POST /api/db/objects  body: {"path": "..."}
#[api(method = "POST", path = "/api/db/objects")]
pub fn db_objects(path str) ObjectList {
    return db.list_objects(path)
}

/// 表/视图数据页（真实 schema 列 + NULL 标志 + 过滤总数）。
/// POST /api/db/table_data
#[api(method = "POST", path = "/api/db/table_data")]
pub fn db_table_data(path str, tname str, page int, page_size int, sort_col str, sort_dir str, search str) TableData {
    return db.table_data(path, tname, page, page_size, sort_col, sort_dir, search)
}

/// 表/视图结构（列/DDL/索引）。
/// POST /api/db/schema  body: {"path": "...", "tname": "..."}
#[api(method = "POST", path = "/api/db/schema")]
pub fn db_schema(path str, tname str) SchemaResult {
    return db.table_schema(path, tname)
}

/// 单条只读查询（SELECT/只读 CTE；真实列名 + NULL 标志 + 显式截断）。
/// POST /api/db/query  body: {"path": "...", "sql": "..."}
#[api(method = "POST", path = "/api/db/query")]
pub fn db_query(path str, sql str) QueryResult {
    return db.run_query(path, sql)
}

// ═══════════════════════════════════════════════════════════
// T-01 能力探针（AUTO_DB_PROBE=1 门禁在 probe 内部；其余返回 "disabled"）
// ═══════════════════════════════════════════════════════════

#[api(method = "GET", path = "/api/probe/open_missing")]
pub fn probe_open_missing() str {
    return db.probe_open_missing()
}

#[api(method = "GET", path = "/api/probe/open_garbage")]
pub fn probe_open_garbage() str {
    return db.probe_open_garbage()
