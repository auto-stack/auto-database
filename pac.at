// pac.at - Database Studio SQLite 可视化客户端（App 轨道填洞 ③·Plan 439）
//
// 对象树导航 + DataTable 深水区（分页/排序/搜索/类型徽章/万行窗口化）
// + 表结构（Schema/DDL）+ SQL 控制台（执行/耗时统计/错误反馈）+ 事务修改。

name: "database"
version: "0.1.0"
description: "SQLite visual database studio - Object Tree, Paginated DataTable, SQL Console, Schema Inspector (vue/vm)"

scene: "ui"
render: "vue"
api: "rust"
title: "Database Studio"
title_zh: "数据库工作室"
front_port: 17838
back_port: 17839
# PLAN-056 T-03（auto-os/PLAN-056 主合同反链见 README）：官方主题包正式
# 接入——`vendor/themes` 为 UI 管理渠道发布的**固定版本快照**（themes 0.2.0，
# 内容 digest 9fa07742dc68aa5377ae06cb2d966386002063f184c515b6c5dddf8a6bef838e，
# 与源包逐文件 sha256 校验等价；不可二次编辑、非第二权威源）。theme 键保持
# 缺省 = follow 语义（宿主策略完整快照 > 本 design 默认 > legacy 回退）。
dep themes {
    path: "vendor/themes"
}
desktop: "true"
